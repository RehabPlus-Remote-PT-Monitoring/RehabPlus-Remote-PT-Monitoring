rules_version = '2';

// RehabPlus Firestore security rules.
//
// The Laravel dashboard uses a service account (Admin SDK / REST), which
// bypasses these rules. They protect against the mobile app and anyone holding
// the public Firebase config:
//   - patients can read only their own profile, prescriptions and sessions,
//     can only add new sessions (never edit or delete them), and can only
//     change their own name, phone number, date of birth and profile picture;
//   - patients can message their therapist and the clinic, reply to, edit
//     and unsend (soft delete: the document stays) only their own messages,
//     pin a real message of the thread, but never delete a message or post
//     as staff;
//   - patients record their acceptance of the Terms and Privacy Policy, which
//     can't be changed or deleted afterwards;
//   - therapists/admins signed in with Firebase can read and manage the
//     patients assigned to them (admins: all patients). Only admins change who
//     a patient is assigned to, archive them, or read or use the "clinic" chat
//     thread;
//   - every patient write needs an existing patients/{uid} profile, so a
//     self-made Firebase login with no profile can't store anything.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return signedIn() && role() == 'admin';
    }

    function caresFor(patientId) {
      return signedIn() && (
        isAdmin() ||
        (role() == 'therapist' &&
         get(/databases/$(database)/documents/patients/$(patientId)).data.therapistId == request.auth.uid)
      );
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // A real patient writing their own data: signed in as uid AND the clinic
    // created their profile. Reads only need isSelf (nothing to leak there).
    function isPatient(uid) {
      return isSelf(uid) && exists(/databases/$(database)/documents/patients/$(uid));
    }

    // Staff may write to a chat thread: admins to both, the patient's
    // therapist only to the "therapist" thread (the dashboard does the same).
    function staffForThread(patientId, threadId) {
      return isAdmin() || (threadId == 'therapist' && caresFor(patientId));
    }

    // What the patient's therapist may change on the profile: only the fields
    // the dashboard's edit form has, with its limits (PatientValidation).
    // Assignment, archiving (which also disables the login on the server) and
    // the account's identity stay with the server or an admin, and no new
    // fields (e.g. a stray "role") can be added.
    function validClinicalEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'condition', 'medicalSummary', 'therapyPlan', 'phone', 'dob', 'updatedAt'])
        && (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 100))
        && (!('condition' in d) || (d.condition is string && d.condition.size() <= 150))
        && (!('medicalSummary' in d) || (d.medicalSummary is string && d.medicalSummary.size() <= 2000))
        && (!('therapyPlan' in d) || (d.therapyPlan is string && d.therapyPlan.size() <= 2000))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('dob' in d) || (d.dob is string && d.dob.size() <= 30))
        && (!('updatedAt' in d) || d.updatedAt is timestamp);
    }

    // Account profile with role: 'patient' | 'therapist' | 'admin' | 'staff'
    // (front desk; dashboard only, so these rules give it nothing).
    // Only the server (service account) creates or changes roles.
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow write: if false;
    }

    match /patients/{patientId} {
      allow read: if isSelf(patientId) || caresFor(patientId);
      allow update: if isAdmin()
        || (caresFor(patientId) && validClinicalEdit())
        || (isSelf(patientId) && validContactEdit());
      allow create, delete: if isAdmin();

      match /prescriptions/{prescriptionId} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow write: if caresFor(patientId);
      }

      match /sessions/{sessionId} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow create: if isPatient(patientId) && validSession(request.resource.data);
        allow update, delete: if false;
      }

      // Notifications page. The server writes most of them (every push it
      // sends); the app may only log its own "session_completed" entries and
      // mark entries read.
      match /notifications/{notificationId} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow create: if isPatient(patientId)
          && request.resource.data.keys().hasOnly(['type', 'title', 'body', 'createdAt', 'read'])
          && request.resource.data.type == 'session_completed'
          && request.resource.data.title is string && request.resource.data.title.size() <= 100
          && request.resource.data.body is string && request.resource.data.body.size() <= 300
          && request.resource.data.read is bool
          && request.resource.data.createdAt == request.time;
        allow update: if isSelf(patientId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read == true;
        allow write: if caresFor(patientId);
      }

      // Push-notification tokens for the patient's phone(s); doc id = token.
      // Staff read them via the service account to send notifications.
      match /devices/{token} {
        allow read: if isSelf(patientId);
        allow create, update: if isPatient(patientId)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt'])
          && request.resource.data.token == token
          && token.size() < 1024
          && request.resource.data.platform in ['android', 'ios']
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(patientId);
      }

      // Which push notifications the patient wants (Settings > Notifications).
      // The dashboard checks it before sending a push.
      match /preferences/{docId} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow create, update: if isPatient(patientId) && docId == 'notifications'
          && request.resource.data.keys().hasOnly(['messages', 'exercises', 'reminders', 'updatedAt'])
          && request.resource.data.messages is bool
          && request.resource.data.exercises is bool
          && (!('reminders' in request.resource.data) || request.resource.data.reminders is bool)
          && request.resource.data.updatedAt == request.time;
        allow delete: if false;
      }

      // Profile picture: JPEG bytes in one doc (no Cloud Storage). The
      // patient sets or removes their own; their care team can see it.
      match /avatar/{docId} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow create, update: if isPatient(patientId) && docId == 'photo'
          && request.resource.data.keys().hasOnly(['image', 'updatedAt'])
          && request.resource.data.image is bytes
          && request.resource.data.image.size() <= 500 * 1024
          && request.resource.data.updatedAt == request.time;
        allow delete: if isSelf(patientId);
      }

      // Acceptance of the Terms and Conditions + Privacy Policy, one doc per
      // version (doc id = version). Append-only: an audit record of consent.
      match /consents/{version} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow create: if isPatient(patientId) && validConsent(request.resource.data, version);
        allow update, delete: if false;
      }

      // Rehab goals: set by the therapist on the dashboard (service account),
      // shown read-only in the app under Profile > My Goals. Assessments and
      // notes stay clinic-only (no rule, so the app can't read them).
      match /goals/{goalId} {
        allow read: if isSelf(patientId) || caresFor(patientId);
        allow write: if false;
      }

      // threadId is 'therapist' or 'clinic'. Staff read only the threads they
      // can write to: the therapist never sees the clinic thread (a patient
      // may be messaging the clinic about them).
      match /threads/{threadId} {
        allow read: if isSelf(patientId) || staffForThread(patientId, threadId);
        allow create: if isPatient(patientId) && validThreadId(threadId)
          && patientThreadFields(request.resource.data, request.resource.data.keys().toSet(), 0,
               patientId, threadId);
        allow update: if isPatient(patientId)
          && patientThreadFields(request.resource.data,
               request.resource.data.diff(resource.data).affectedKeys(),
               resource.data.get('unreadForStaff', 0), patientId, threadId);
        allow create, update: if validThreadId(threadId) && staffForThread(patientId, threadId);
        // Deleting a thread would orphan its messages; nobody does that.
        allow delete: if isAdmin();

        match /messages/{messageId} {
          allow read: if isSelf(patientId) || staffForThread(patientId, threadId);
          allow create: if validThreadId(threadId) && (
            (isPatient(patientId) && validMessage(request.resource.data, 'patient', patientId, threadId))
            || (staffForThread(patientId, threadId)
                && validMessage(request.resource.data, 'staff', patientId, threadId)));
          // Edit or unsend, by the message's own author only.
          allow update: if validThreadId(threadId)
            && (isPatient(patientId) || staffForThread(patientId, threadId))
            && validMessageAction(request.resource.data, resource.data);
          // Unsend is a soft delete; a message document is never removed.
          allow delete: if false;
        }
      }
    }

    // Clinic contact details shown in the app (phone for the call button).
    match /settings/clinic {
      allow read: if signedIn();
      allow write: if false;
    }

    function validThreadId(threadId) {
      return threadId in ['therapist', 'clinic'];
    }

    // What a patient may change on their thread doc: the last-message preview
    // (as themselves), add one to the staff unread count per message they
    // send, and clear their own. lastMessageAt is the phone's clock (messages
    // can be queued offline), so it's only type-checked.
    //
    // Chat actions also touch it: lastActionAt (server time, set by every edit
    // and unsend so the dashboard reloads) and the pin (see validPinChange).
    function patientThreadFields(d, changed, staffUnreadBefore, patientId, threadId) {
      return changed.hasOnly(['lastMessage', 'lastMessageAt', 'lastSenderRole',
                              'unreadForStaff', 'unreadForPatient', 'lastActionAt',
                              'pinnedMessageId', 'pinnedText', 'pinnedSenderRole', 'pinnedAt'])
        && validPinChange(d, changed, patientId, threadId)
        && (!('lastActionAt' in changed) || d.lastActionAt == request.time)
        && (!('unreadForPatient' in changed) || d.unreadForPatient == 0)
        && (!('lastSenderRole' in changed) || d.lastSenderRole == 'patient')
        && (!('lastMessage' in changed) || (d.lastMessage is string && d.lastMessage.size() <= 1000))
        && (!('lastMessageAt' in changed) || (d.lastMessageAt is timestamp && notInFuture(d.lastMessageAt)))
        && (!('unreadForStaff' in changed) || d.unreadForStaff == staffUnreadBefore + 1);
    }

    // The thread's one pin, shared by both sides. Only a pin field that
    // changes is checked (an odd pin the dashboard wrote never blocks a
    // send). Allowed: removing all four fields; refreshing pinnedText alone
    // (editing the pinned message); or a new pin, all four fields at once,
    // pointing at a real, not unsent message of this thread with its real
    // author, pinnedAt = now.
    function validPinChange(d, changed, patientId, threadId) {
      let pinFields = ['pinnedMessageId', 'pinnedText', 'pinnedSenderRole', 'pinnedAt'];
      let pinChanged = changed.intersection(pinFields.toSet());
      return pinChanged.size() == 0
        || !d.keys().hasAny(pinFields)
        || (pinChanged.hasOnly(['pinnedText']) && 'pinnedMessageId' in d
            && d.pinnedText is string && d.pinnedText.size() <= 200)
        || (d.keys().hasAll(pinFields)
            && d.pinnedMessageId is string && d.pinnedMessageId.size() > 0
            && d.pinnedMessageId.size() <= 128
            && d.pinnedText is string && d.pinnedText.size() <= 200
            && d.pinnedAt == request.time
            && liveMessageBy(patientId, threadId, d.pinnedMessageId, d.pinnedSenderRole));
    }

    // A message of this thread that exists, is not unsent and was written
    // by [role] ('patient' / 'staff'): what a pin or a reply quote may point
    // at, so neither can show a made-up "staff said" text as real.
    function liveMessageBy(patientId, threadId, messageId, role) {
      let path = /databases/$(database)/documents/patients/$(patientId)/threads/$(threadId)/messages/$(messageId);
      return exists(path)
        && get(path).data.get('unsent', false) != true
        && get(path).data.get('senderRole', '') == role;
    }

    // A new message. replyTo (the quote of the message being answered) is
    // the only optional field.
    function validMessage(d, role, patientId, threadId) {
      return d.keys().hasOnly(['text', 'senderId', 'senderRole', 'sentAt', 'createdAt', 'replyTo'])
        && d.keys().hasAll(['text', 'senderId', 'senderRole', 'sentAt', 'createdAt'])
        && (!('replyTo' in d) || validReplyTo(d.replyTo, patientId, threadId))
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && d.senderId == request.auth.uid
        && d.senderRole == role
        && d.sentAt is timestamp && notInFuture(d.sentAt)
        && d.createdAt == request.time;
    }

    // The quote a reply carries: the quoted message's id, a snippet of its
    // text (at most 200 characters) and who wrote it; the quoted message must
    // be a real, not unsent message of this thread by that author.
    function validReplyTo(r, patientId, threadId) {
      return r is map
        && r.keys().hasOnly(['id', 'text', 'senderRole'])
        && r.keys().hasAll(['id', 'text', 'senderRole'])
        && r.id is string && r.id.size() > 0 && r.id.size() <= 128
        && r.text is string && r.text.size() <= 200
        && r.senderRole in ['patient', 'staff']
        && liveMessageBy(patientId, threadId, r.id, r.senderRole);
    }

    // An action on an existing message by its author: an edit (new text,
    // editedAt = now) or an unsend (soft delete: text emptied, unsent = true,
    // unsentAt = now, reply quote and session card removed). Nothing else may
    // change, and an unsent message is final. Messages are never deleted.
    function validMessageAction(d, before) {
      let changed = d.diff(before).affectedKeys();
      let isEdit = changed.hasOnly(['text', 'editedAt'])
        && d.text is string && d.text.size() > 0 && d.text.size() <= 1000
        && d.editedAt == request.time;
      let isUnsend = changed.hasOnly(['text', 'unsent', 'unsentAt', 'replyTo', 'session'])
        && d.text == '' && d.unsent == true && d.unsentAt == request.time
        && !('replyTo' in d) && !('session' in d);
      return before.get('unsent', false) != true
        && before.senderId == request.auth.uid
        && (isEdit || isUnsend);
    }

    function validConsent(d, version) {
      return d.keys().hasOnly(['version', 'acceptedTerms', 'acceptedPrivacyPolicy',
                               'healthDataConsent', 'cameraConsent', 'acceptedAt'])
        && d.version == version && version.size() <= 40
        && d.acceptedTerms == true
        && d.acceptedPrivacyPolicy == true
        && d.healthDataConsent == true
        && d.cameraConsent == true
        && d.acceptedAt == request.time;
    }

    // Patient-editable profile fields. gender is '' when not set; weightKg
    // (kg) and heightCm (cm) are null when not set. Same limits as
    // ProfileService (the app validates them too).
    function validContactEdit() {
      let d = request.resource.data;
      return d.diff(resource.data).affectedKeys().hasOnly(
          ['name', 'phone', 'dob', 'gender', 'weightKg', 'heightCm'])
        && (!('name' in d) || (d.name is string && d.name.size() > 0 && d.name.size() <= 100))
        && (!('phone' in d) || (d.phone is string && d.phone.size() <= 30))
        && (!('dob' in d) || (d.dob is string && d.dob.size() <= 30))
        && (!('gender' in d) || (d.gender is string && d.gender in ['', 'Female', 'Male', 'Other', 'Prefer not to say']))
        && (!('weightKg' in d) || d.weightKg == null || (d.weightKg is number && d.weightKg >= 1 && d.weightKg <= 500))
        && (!('heightCm' in d) || d.heightCm == null || (d.heightCm is number && d.heightCm >= 30 && d.heightCm <= 300));
    }

    function validSession(d) {
      return d.keys().hasOnly([
          'exerciseId', 'exerciseName', 'prescriptionId',
          'startTime', 'endTime', 'createdAt',
          'completedReps', 'completedSets', 'targetReps', 'targetSets',
          'rejectedReps', 'repComplianceScores', 'overallCompliance',
          'painLevel', 'painNote', 'notes', 'outsideSchedule', 'endedEarly'])
        && d.keys().hasAll(['exerciseId', 'startTime', 'completedReps', 'painLevel'])
        // Every field is type- and size-checked: the dashboard shows these to
        // staff, and a wrong type (e.g. a map as the exercise name) used to
        // break the patient's page for everyone.
        && d.exerciseId is string && d.exerciseId.size() > 0 && d.exerciseId.size() <= 100
        && optionalText(d, 'exerciseName', 100)
        && optionalText(d, 'prescriptionId', 128)
        && optionalText(d, 'notes', 2000)
        && d.startTime is timestamp && notInFuture(d.startTime)
        && (!('endTime' in d) || d.endTime == null
            || (d.endTime is timestamp && notInFuture(d.endTime) && d.endTime >= d.startTime))
        && validCount(d.completedReps)
        && (!('completedSets' in d) || validCount(d.completedSets))
        && (!('targetReps' in d) || validCount(d.targetReps))
        && (!('targetSets' in d) || validCount(d.targetSets))
        && (!('rejectedReps' in d) || validCount(d.rejectedReps))
        // Rules can't check the type of each entry, only the length; readers
        // (the app's history chart) must treat the entries as untrusted.
        && (!('repComplianceScores' in d)
            || (d.repComplianceScores is list && d.repComplianceScores.size() <= 10000))
        && (!('overallCompliance' in d) || d.overallCompliance == null
            || (d.overallCompliance is number && d.overallCompliance >= 0 && d.overallCompliance <= 1))
        && d.painLevel is int && d.painLevel >= 0 && d.painLevel <= 10
        && (d.painNote == null || (d.painNote is string && d.painNote.size() <= 300))
        && (!('outsideSchedule' in d) || d.outsideSchedule is bool)
        && (!('endedEarly' in d) || d.endedEarly is bool)
        && d.createdAt == request.time;
    }

    // Rep/set counts: same cap as ExerciseSession.maxCount in the app.
    function validCount(n) {
      return n is int && n >= 0 && n <= 10000;
    }

    // Absent, null, or a string of at most max characters.
    function optionalText(d, field, max) {
      return !(field in d) || d[field] == null || (d[field] is string && d[field].size() <= max);
    }

    // Times taken from the phone's clock (it may be offline, so the past is
    // fine) may run at most an hour ahead of the server. Without this a
    // patient could date a message 2099 and pin it to the top for good. The
    // dashboard ignores times past the same limit (CLOCK_SKEW_MINUTES).
    function notInFuture(t) {
      return t <= request.time + duration.value(1, 'h');
    }
  }
}
